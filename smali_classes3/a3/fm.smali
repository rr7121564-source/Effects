.class final La3/fm;
.super La3/hm;


# direct methods
.method public constructor <init>(Ljava/lang/String;)V
    .locals 0

    const-string p1, "Fetch failed: Firebase instance id is null."

    invoke-direct {p0, p1}, La3/hm;-><init>(Ljava/lang/String;)V

    return-void
.end method

.method public constructor <init>(Ljava/lang/String;Ljava/lang/Throwable;)V
    .locals 0

    invoke-direct {p0, p1, p2}, La3/hm;-><init>(Ljava/lang/String;Ljava/lang/Throwable;)V

    return-void
.end method
