<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/ll_root"
    android:background="@drawable/bg_round_12"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/fg_efftect_12"
    android:minHeight="55.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="15.0dip"
        android:paddingTop="10.0dip"
        android:paddingRight="15.0dip"
        android:paddingBottom="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:theme="@style/fontSemi"
                    android:textSize="17.0dip"
                    android:textColor="@color/cl_text1"
                    android:id="@id/widget_choose_color_tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="250.0dip"
                    android:text="Ẩn văn bản nguồn Ẩn văn bản nguồn"
                    android:includeFontPadding="false" />
                <ImageView
                    android:id="@id/widget_choose_color_iv_vip"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginTop="2.0dip"
                    android:src="@drawable/ic_premium_no_bg"
                    android:layout_marginStart="10.0dip" />
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:background="#ff818384"
                android:padding="1.0dip"
                android:layout_width="25.0dip"
                android:layout_height="25.0dip"
                android:layout_marginLeft="30.0dip"
                android:layout_marginRight="5.0dip">
                <View
                    android:id="@id/widget_choose_color_v_color"
                    android:background="@color/white"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>