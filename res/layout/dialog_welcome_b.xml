<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/dialog_purchase_fl_root"
    android:background="@color/cl_background_white_grayB"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/dialog_welcome_rl_top_view"
            android:background="@drawable/bg_multi_color_welcom"
            android:paddingTop="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <FrameLayout
                android:background="@drawable/bg_round_top_20_gray"
                android:paddingLeft="10.0dip"
                android:paddingTop="15.0dip"
                android:paddingRight="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50.0dip"
                android:layout_marginRight="50.0dip"
                android:layout_alignParentBottom="true">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@id/container_video"
                    android:layout_width="fill_parent"
                    android:layout_height="400.0dip">
                    <androidx.media3.ui.PlayerView
                        android:id="@id/playerView"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        app:resize_mode="fit"
                        app:surface_type="texture_view"
                        app:use_controller="false" />
                    <ImageView
                        android:id="@id/imgPoster"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/tos_poster_game" />
                </FrameLayout>
            </FrameLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="0.7">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="30.0dip"
                android:paddingRight="30.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_marginTop="10.0dip"
                android:layout_weight="1.0">
                <androidx.core.widget.NestedScrollView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:fillViewport="true">
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingTop="20.0dip"
                        android:paddingBottom="20.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:theme="@style/fontBold"
                            android:textSize="28.0dip"
                            android:textColor="@color/cl_text1"
                            android:gravity="center|left"
                            android:id="@id/dialog_purchase_tv_premium"
                            android:visibility="visible"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/main_text_game"
                            android:includeFontPadding="false" />
                        <TextView
                            android:theme="@style/fontMedium"
                            android:textSize="14.0dip"
                            android:textColor="@color/cl_text1"
                            android:gravity="center|left"
                            android:id="@id/dialog_purchase_tv_premiuma"
                            android:visibility="visible"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:text="@string/sub_text_game"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
            <TextView
                android:theme="@style/fontBold"
                android:textSize="18.0dip"
                android:textColor="@color/cl_white_sameWhite"
                android:gravity="center"
                android:id="@id/dialog_welcome_a_tv_next"
                android:background="@drawable/bg_round_30_blue"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="50.0dip"
                android:layout_marginLeft="15.0dip"
                android:layout_marginTop="15.0dip"
                android:layout_marginRight="15.0dip"
                android:layout_marginBottom="25.0dip"
                android:foreground="@drawable/fg_efftect_30"
                android:text="@string/get_started"
                android:includeFontPadding="false"
                android:elevation="2.0dip" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>