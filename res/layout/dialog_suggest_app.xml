<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@id/dialog_suggest_app_ll_root"
    android:background="@drawable/bg_dialog_center"
    android:paddingTop="5.0dip"
    android:paddingBottom="15.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20.0dip"
    android:layout_marginRight="20.0dip"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:theme="@style/fontBold"
        android:textSize="30.0dip"
        android:textColor="@color/defaultDarkColor"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suggested App" />
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="15.0dip"
        android:paddingRight="15.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.0dip">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@id/dialog_suggest_app_iv_app_icon"
                android:background="@drawable/bg_radius_imageview"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip" />
            <TextView
                android:textSize="11.0dip"
                android:textColor="@color/cl_white_sameWhite"
                android:gravity="center"
                android:background="@color/yellow"
                android:layout_width="18.0dip"
                android:layout_height="18.0dip"
                android:layout_marginLeft="34.0dip"
                android:layout_marginTop="22.0dip"
                android:text="Ad" />
        </RelativeLayout>
        <TextView
            android:textSize="19.0dip"
            android:textColor="@color/cl_text2"
            android:id="@id/dialog_suggest_app_tv_app_name"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dip"
            android:layout_marginRight="2.0dip"
            android:text="Free Translate, Voice, Camera, Image"
            android:layout_weight="1.0" />
    </LinearLayout>
    <TextView
        android:textSize="17.0dip"
        android:textColor="@color/cl_text2"
        android:gravity="start|center"
        android:id="@id/dialog_suggest_app_tv_detail"
        android:paddingLeft="15.0dip"
        android:paddingRight="15.0dip"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.0dip"
        android:text="- Free Translate, Voice, Camera, Image\n- Học từ vựng tiếng Anh, 100 Từ Vựng tiếng anh" />
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="25.0dip"
        android:paddingRight="25.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip">
        <TextView
            android:theme="@style/fontBold"
            android:textSize="18.0dip"
            android:textColor="@color/defaultDarkColor"
            android:id="@id/dialog_suggest_app_tv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/close" />
        <View
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0" />
        <TextView
            android:theme="@style/fontBold"
            android:textSize="18.0dip"
            android:textColor="@color/defaultDarkColor"
            android:layout_gravity="center"
            android:id="@id/dialog_suggest_app_tv_install"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Install" />
    </LinearLayout>
</LinearLayout>