<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ll_item_language"
    android:background="@drawable/effect_view_click_radius"
    android:paddingTop="2.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/item_sort_webview_ll_root"
        android:background="@drawable/effect_view_click_radius"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="30.0dip"
            android:textColor="@color/cl_text1"
            android:gravity="center|left"
            android:id="@id/item_sort_webview_tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dip"
            android:layout_marginRight="20.0dip"
            android:text="Vietnamese"
            android:layout_weight="1.0" />
        <ImageView
            android:layout_gravity="center"
            android:id="@id/item_sort_webview_iv_move_up"
            android:paddingLeft="4.0dip"
            android:paddingRight="4.0dip"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:src="@drawable/more"
            android:rotation="180.0" />
    </LinearLayout>
    <View
        android:background="@color/cl_underline"
        android:layout_width="fill_parent"
        android:layout_height="0.5dip" />
</LinearLayout>