<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/activity_main_root"
    android:background="@color/cl_background_grayW_black"
    android:paddingTop="25.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/activity_main_ll_title_top"
        android:background="@color/cl_background_grayW_black"
        android:layout_width="fill_parent"
        android:layout_height="45.0dip">
        <TextView
            android:theme="@style/fontBold"
            android:textSize="18.299988dip"
            android:textColor="@color/cl_text1"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginLeft="20.0dip"
            android:text="@string/app_name"
            android:includeFontPadding="false" />
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_alignParentRight="true">
            <ImageView
                android:id="@id/img_tutorial"
                android:background="@drawable/bg_circle_icon"
                android:padding="8.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="33.0dip"
                android:layout_height="33.0dip"
                android:foreground="@drawable/fg_efftect_circle"
                android:src="@drawable/ic_tutorial_svg_new" />
            <ImageView
                android:id="@id/translate_text_iv_history"
                android:background="@drawable/bg_circle_icon"
                android:padding="6.5999756dip"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="33.0dip"
                android:layout_height="33.0dip"
                android:layout_marginRight="12.0dip"
                android:foreground="@drawable/fg_efftect_circle"
                android:src="@drawable/ic_history_svg" />
            <ImageView
                android:id="@id/img_premium"
                android:background="@drawable/bg_circle_icon_premium"
                android:padding="6.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:layout_marginLeft="8.0dip"
                android:layout_marginRight="12.0dip"
                android:foreground="@drawable/fg_efftect_circle"
                android:src="@drawable/ic_premium_with_bg" />
        </LinearLayout>
    </RelativeLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@id/activity_main_viewpager"
        android:background="@color/cl_background_grayW_black"
        android:saveEnabled="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:nestedScrollingEnabled="true" />
    <View
        android:background="@color/cl_underline"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_gravity="bottom"
        android:id="@id/activity_bottom_navigation"
        android:background="@color/cl_background_white_black"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:itemIconTint="@color/bg_item_bottom_bar"
        app:itemTextColor="@color/bg_item_bottom_bar"
        app:menu="@menu/menu_bottom" />
</LinearLayout>