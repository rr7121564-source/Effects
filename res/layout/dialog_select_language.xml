<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/language_source_ll_close"
    android:background="@color/cl_background_white_grayB"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15.0dip">
                <TextView
                    android:theme="@style/fontBold"
                    android:textSize="20.0dip"
                    android:textColor="@color/cl_text1"
                    android:gravity="center"
                    android:id="@id/tv_title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_language"
                    android:includeFontPadding="false"
                    android:layout_centerInParent="true" />
                <ImageView
                    android:id="@id/iv_back_dialog_source"
                    android:padding="5.0dip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="35.0dip"
                    android:layout_height="35.0dip"
                    android:layout_marginLeft="15.0dip"
                    android:foreground="@drawable/fg_efftect_circle"
                    android:src="@drawable/ic_back_s"
                    android:layout_alignParentLeft="true" />
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/bg_radius_plus"
                android:paddingLeft="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginLeft="15.0dip"
                android:layout_marginTop="15.0dip"
                android:layout_marginRight="15.0dip"
                android:layout_marginBottom="15.0dip">
                <ImageView
                    android:layout_gravity="center"
                    android:padding="1.0dip"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:src="@drawable/ic_search_s" />
                <EditText
                    android:textColorHint="@color/cl_text_hint"
                    android:gravity="left"
                    android:layout_gravity="center"
                    android:id="@id/edt_search"
                    android:paddingLeft="15.0dip"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginRight="15.0dip"
                    android:layout_marginBottom="-3.0dip"
                    android:hint="@string/search"
                    android:includeFontPadding="false"
                    android:layout_weight="1.0"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:backgroundTint="@color/cl_background_grayW_black" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/dialog_language_source_lv_choose"
                android:paddingLeft="15.0dip"
                android:paddingRight="15.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>