<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/ll_item_language"
        android:background="@drawable/bg_round_12"
        android:paddingTop="5.0dip"
        android:paddingBottom="5.0dip"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/fg_efftect_12">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/custom_lv_iv_flag"
            android:layout_width="35.0dip"
            android:layout_height="35.0dip"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="3.0dip"
            android:layout_marginBottom="3.0dip"
            android:layout_marginEnd="10.0dip" />
        <LinearLayout
            android:gravity="center|left"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dip"
            android:layout_marginRight="6.0dip"
            android:layout_marginBottom="2.0dip"
            android:layout_weight="1.0">
            <TextView
                android:textSize="18.0dip"
                android:textColor="@color/cl_text1"
                android:gravity="center|left"
                android:layout_gravity="center"
                android:id="@id/custom_lv_tv_language"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="English"
                android:layout_weight="2.0" />
            <TextView
                android:textSize="12.0dip"
                android:textColor="@color/cl_text2"
                android:gravity="center|left"
                android:layout_gravity="center"
                android:id="@id/custom_lv_tv_language_local"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="Tiếng Anh"
                android:includeFontPadding="false"
                android:layout_weight="1.0" />
        </LinearLayout>
        <TextView
            android:textSize="10.0dip"
            android:textColor="#ffff9800"
            android:gravity="center|left"
            android:layout_gravity="center"
            android:id="@id/custom_lv_tv_beta"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="Beta"
            android:includeFontPadding="false" />
        <ImageView
            android:id="@id/img_download"
            android:padding="8.0dip"
            android:layout_width="30.0dip"
            android:layout_height="fill_parent"
            android:layout_marginLeft="3.0dip"
            android:layout_marginBottom="2.0dip"
            android:src="@drawable/ic_download_svg" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/custom_lv_ll_language_view_line_used"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15.0dip"
        android:layout_marginTop="15.0dip"
        android:layout_marginRight="15.0dip"
        android:layout_marginBottom="15.0dip">
        <TextView
            android:theme="@style/fontSemi"
            android:textSize="16.0dip"
            android:textColor="@color/cl_text1"
            android:gravity="center|left"
            android:layout_gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="All Languages"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>