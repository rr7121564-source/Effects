<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/ll_root"
    android:background="@drawable/bg_round_12"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/fg_efftect_12"
    android:minHeight="55.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="15.0dip"
        android:paddingTop="10.0dip"
        android:paddingRight="15.0dip"
        android:paddingBottom="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <LinearLayout
                android:gravity="center|left"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:theme="@style/fontSemi"
                    android:textSize="17.0dip"
                    android:textColor="@color/cl_text1"
                    android:gravity="left"
                    android:id="@id/widget_choose_action_tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="250.0dip"
                    android:text="Action on Long-press"
                    android:includeFontPadding="false" />
                <ImageView
                    android:id="@id/widget_choose_action_iv_vip"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:src="@drawable/ic_premium_no_bg"
                    android:layout_marginStart="10.0dip" />
            </LinearLayout>
            <TextView
                android:textSize="12.0dip"
                android:textColor="@color/cl_text2"
                android:gravity="left"
                android:id="@id/widget_choose_action_tv_detail"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.0dip"
                android:text="@string/double_tap_delay_tap"
                android:includeFontPadding="false" />
            <TextView
                android:theme="@style/fontSemi"
                android:textSize="14.0dip"
                android:textColor="@color/cl_text1"
                android:id="@id/widget_choose_action_tv_action"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginTop="3.0dip"
                android:text="Open option menu"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="15.0dip"
            android:layout_height="15.0dip"
            android:layout_marginRight="5.0dip"
            android:src="@drawable/ic_more_down" />
    </LinearLayout>
</LinearLayout>