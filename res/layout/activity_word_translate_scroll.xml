<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.tabs.TabLayout
        android:id="@id/activity_nghia_tl_sector"
        android:background="@color/defaultColor"
        android:paddingTop="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="60.0dip"
        app:tabIndicatorColor="@color/white"
        app:tabIndicatorHeight="1.0dip"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/white"
        app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        app:tabTextColor="#ffd1ddee" />
    <View
        android:background="@color/defaultColor"
        android:layout_width="fill_parent"
        android:layout_height="0.20000005dip" />
    <androidx.viewpager.widget.ViewPager
        android:id="@id/activity_nghia_vp_mean"
        android:layout_width="fill_parent"
        android:layout_height="300.0dip" />
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/cl_background_white_black"
        android:layout_width="fill_parent"
        android:layout_height="30.0dip">
        <View
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="3.0" />
        <ImageView
            android:gravity="center"
            android:id="@id/img_scroll"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/scroll"
            android:layout_weight="3.0" />
        <TextView
            android:textSize="18.0dip"
            android:textColor="@color/defaultDarkColor"
            android:gravity="center|right"
            android:id="@id/tv_close_dialog_word"
            android:paddingRight="5.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:text="@string/close"
            android:layout_weight="3.0" />
    </LinearLayout>
    <View
        android:background="@color/defaultColor"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
    <TextView
        android:background="@color/transparent"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1.0" />
</LinearLayout>