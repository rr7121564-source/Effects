<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/ll_root"
    android:background="@drawable/bg_round_12"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/fg_efftect_12"
    android:minHeight="55.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="15.0dip"
        android:paddingTop="10.0dip"
        android:paddingRight="15.0dip"
        android:paddingBottom="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:theme="@style/fontSemi"
                    android:textSize="17.0dip"
                    android:textColor="@color/cl_text1"
                    android:gravity="left"
                    android:id="@id/widget_switch_tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="250.0dip"
                    android:text="Ẩn văn bản nguồn Ẩn văn bản nguồn"
                    android:includeFontPadding="false" />
                <ImageView
                    android:id="@id/widget_switch_iv_vip"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginTop="2.0dip"
                    android:src="@drawable/ic_premium_no_bg"
                    android:layout_marginStart="10.0dip" />
            </LinearLayout>
            <Switch
                android:id="@id/widget_switch_sw"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5.0dip"
                android:thumb="@drawable/bg_switch_thumb"
                android:track="@drawable/bg_switch_selector"
                android:thumbTextPadding="13.0dip"
                android:layout_marginStart="20.0dip" />
        </LinearLayout>
        <TextView
            android:textSize="13.0dip"
            android:textColor="@color/cl_text2"
            android:gravity="left"
            android:id="@id/widget_switch_tv_detail"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:text="Ẩn văn bản nguồn Ẩn văn bản nguồn"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>