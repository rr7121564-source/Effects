<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_root"
    android:background="@color/cl_background_white_grayB"
    android:paddingLeft="15.0dip"
    android:paddingRight="15.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip">
        <ImageView
            android:layout_gravity="left"
            android:id="@id/iv_back_dialog_source"
            android:padding="5.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="35.0dip"
            android:layout_height="35.0dip"
            android:foreground="@drawable/fg_efftect_circle"
            android:src="@drawable/ic_back_s" />
        <TextView
            android:theme="@style/fontBold"
            android:textSize="20.0dip"
            android:textColor="@color/cl_text1"
            android:gravity="center"
            android:id="@id/tv_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="35.0dip"
            android:text="@string/choose_language"
            android:includeFontPadding="false" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/dialog_language_source_lv_choose"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginTop="15.0dip"
        android:layout_weight="1.0" />
</LinearLayout>