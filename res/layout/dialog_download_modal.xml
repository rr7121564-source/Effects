<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@id/dialog_permission_ll_root"
    android:background="@drawable/bg_dialog_center"
    android:paddingTop="20.0dip"
    android:paddingBottom="15.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20.0dip"
    android:layout_marginRight="20.0dip"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:theme="@style/fontBold"
        android:textSize="23.5dip"
        android:textColor="@color/cl_text1"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name" />
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="10.0dip"
        android:paddingRight="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.0dip"
        android:layout_marginBottom="10.0dip">
        <TextView
            android:textSize="16.0dip"
            android:textColor="@color/cl_text1"
            android:id="@id/dialog_permission_tv_detail"
            android:paddingLeft="15.0dip"
            android:paddingRight="15.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_language" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.0dip">
            <TextView
                android:theme="@style/fontSemi"
                android:textSize="17.0dip"
                android:textColor="@color/cl_text2"
                android:gravity="center|left"
                android:id="@id/dialog_permission_tv_cancel"
                android:background="@drawable/bg_button_cancel"
                android:paddingLeft="25.0dip"
                android:paddingTop="6.0dip"
                android:paddingRight="25.0dip"
                android:paddingBottom="6.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15.0dip"
                android:layout_marginTop="10.0dip"
                android:foreground="@drawable/fg_efftect_20"
                android:text="@string/cancel"
                android:includeFontPadding="false" />
            <View
                android:layout_width="0.0dip"
                android:layout_height="1.0dip"
                android:layout_weight="1.0" />
            <TextView
                android:theme="@style/fontSemi"
                android:textSize="17.0dip"
                android:textColor="@color/white"
                android:gravity="center|right"
                android:id="@id/dialog_permission_tv_accept"
                android:background="@drawable/bg_round_20_blue"
                android:paddingLeft="25.0dip"
                android:paddingTop="6.0dip"
                android:paddingRight="25.0dip"
                android:paddingBottom="6.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="15.0dip"
                android:foreground="@drawable/fg_efftect_20"
                android:text="@string/download"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>