<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/rootView"
    android:background="@color/black"
    android:paddingTop="25.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <androidx.camera.view.PreviewView
            android:id="@id/activity_camera_translate_preview"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <RelativeLayout
            android:id="@id/activity_camera_translate_rl_container"
            android:background="@color/transparent"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <ImageView
            android:id="@id/activity_camera_translate_iv_close"
            android:padding="10.0dip"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_marginLeft="10.0dip"
            android:layout_marginTop="10.0dip"
            android:src="@drawable/ic_back" />
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:background="@color/black"
        android:paddingTop="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip">
        <TextView
            android:theme="@style/fontSemi"
            android:textSize="14.0dip"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/activity_camera_translate_tv1"
            android:background="@drawable/ic_take_photo"
            android:paddingRight="2.0dip"
            android:paddingBottom="2.0dip"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:text="1x" />
        <TextView
            android:theme="@style/fontSemi"
            android:textSize="14.0dip"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/activity_camera_translate_tv2"
            android:background="@drawable/ic_take_photo"
            android:paddingBottom="2.0dip"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:layout_marginLeft="25.0dip"
            android:text="2x" />
        <TextView
            android:theme="@style/fontSemi"
            android:textSize="14.0dip"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/activity_camera_translate_tv4"
            android:background="@drawable/ic_take_photo"
            android:paddingRight="1.0dip"
            android:paddingBottom="2.0dip"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:layout_marginLeft="25.0dip"
            android:text="4x" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:background="@color/black"
        android:paddingBottom="30.0dip"
        android:layout_width="fill_parent"
        android:layout_height="150.0dip">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/activity_camera_translate_iv_capture"
            android:layout_width="70.0dip"
            android:layout_height="70.0dip"
            android:src="@drawable/ic_take_photo"
            android:layout_centerInParent="true" />
        <ImageView
            android:layout_gravity="center"
            android:id="@id/activity_camera_translate_iv_reset"
            android:layout_width="70.0dip"
            android:layout_height="70.0dip"
            android:src="@drawable/ic_reset_photo"
            android:layout_centerInParent="true" />
        <ProgressBar
            android:layout_gravity="center"
            android:id="@id/activity_camera_translate_iv_pb_loading"
            android:layout_width="70.0dip"
            android:layout_height="70.0dip"
            android:indeterminateDrawable="@drawable/progress" />
    </LinearLayout>
</LinearLayout>